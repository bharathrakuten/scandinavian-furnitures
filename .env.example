# NextAuth.js Configuration
# Get these values from Google Cloud Console
# https://console.cloud.google.com/

# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET=your_secret_key_here

# Google OAuth Credentials
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# Application URL (for local development)
NEXTAUTH_URL=http://localhost:3000
